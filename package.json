{
  "name": "joy-pitwall",
  "productName": "JOY Pitwall",
  "version": "0.1.0",
  "description": "Race engineering suite — run a weekend as chief/race engineer across multiple teams and cars.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.joy.pitwall",
    "productName": "JOY Pitwall",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "JOY-Pitwall-Portable.exe"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "flag-icons": "^7.2.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
